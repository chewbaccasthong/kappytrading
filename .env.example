# ── Kalshi API ──────────────────────────────────────────────────
# Get these from: https://kalshi.com/account/api (Demo) or https://demo.kalshi.co
KALSHI_API_KEY=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem
# Demo URL (default) — change to live when ready:
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
KALSHI_DEMO=true

# ── Risk Management ──────────────────────────────────────────────
MAX_POSITION_SIZE=10        # Max contracts per market
MAX_DAILY_LOSS=50           # Stop trading after $50 daily loss
MAX_OPEN_POSITIONS=5        # Max concurrent open positions
MIN_EDGE_THRESHOLD=0.05     # Minimum 5% edge required to trade

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/trades.db

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
